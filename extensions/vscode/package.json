  "version": "1.0.0",
  "publisher": "folio",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b1a17",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "icons",
    "icon theme",
    "file icons",
    "folder icons",
    "minimal",
    "flat",
    "monochrome",
    "pictogram",
    "color theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/divyanshkaranwork-source/ICon-repositry"
  },
  "bugs": {
    "url": "https://github.com/divyanshkaranwork-source/ICon-repositry/issues"
  },
  "homepage": "https://github.com/divyanshkaranwork-source/ICon-repositry#readme",
  "contributes": {
    "iconThemes": [
      {
        "id": "folio-ink",
        "label": "Folio Ink",
        "path": "./themes/folio-ink.json"
      },
      {
        "id": "folio-graphite",
        "label": "Folio Graphite",
        "path": "./themes/folio-graphite.json"
      },
      {
        "id": "folio-primary",
        "label": "Folio Primary",
        "path": "./themes/folio-primary.json"
      }
    ],
    "themes": [
      {
        "label": "Folio Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/folio-dark-color-theme.json"
      },
      {
        "label": "Folio Light",
        "uiTheme": "vs",
        "path": "./themes/folio-light-color-theme.json"
      }
    ]
  }
}
