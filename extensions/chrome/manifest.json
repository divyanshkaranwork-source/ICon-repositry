{
  "manifest_version": 3,
  "name": "Lumora Icons for GitHub",
  "short_name": "Lumora",
  "version": "1.0.0",
  "description": "Premium, abstract file & folder icons for GitHub — five editions: Aurora, Noir, Frost, Halo and Gilded.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lumora Icons",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "dist/gallery.html",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ]
}
